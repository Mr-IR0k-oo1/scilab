{
  "schema_version": 1,
  "id": "signal.fft_filtering",
  "name": "Signal Noise Spectrum & FFT Analysis",
  "version": "1.0.0",
  "category": "signal_processing",
  "description": "Generates a multi-tone noisy sinusoidal signal and performs Fast Fourier Transform (FFT) frequency spectrum analysis.",
  "difficulty": "intermediate",
  "scilab_version": ">=6.0.0",
  "entry_experiment": "scripts/main.sce",
  "parameters": [
    {
      "name": "freq_hz",
      "label": "Fundamental Frequency (Hz)",
      "type": "number",
      "default": 50.0,
      "minimum": 1.0,
      "maximum": 500.0,
      "step": 5.0,
      "unit": "Hz"
    },
    {
      "name": "noise_amp",
      "label": "Noise Amplitude",
      "type": "number",
      "default": 0.5,
      "minimum": 0.0,
      "maximum": 5.0,
      "step": 0.1,
      "unit": ""
    }
  ],
  "tags": ["signal", "fft", "spectrum", "fourier", "filtering"]
}
