/*
  Scilab Studio - Light Theme
*/

QMainWindow {
    background-color: #f3f3f3;
    color: #333333;
}

QWidget {
    background-color: #f3f3f3;
    color: #333333;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* Menu Bar */
QMenuBar {
    background-color: #dddddd;
    color: #333333;
    border-bottom: 1px solid #cccccc;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #cce8ff;
    color: #000000;
}

QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    padding: 4px;
}

QMenu::item:selected {
    background-color: #007acc;
    color: #ffffff;
}

/* ToolBar */
QToolBar {
    background-color: #e5e5e5;
    border-bottom: 1px solid #cccccc;
    spacing: 6px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #333333;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
}

QToolButton:hover {
    background-color: #d0d0d0;
    border: 1px solid #bbbbbb;
}

/* Dock Widgets */
QDockWidget::title {
    background-color: #e5e5e5;
    border-bottom: 1px solid #cccccc;
    padding: 6px 10px;
    font-weight: 600;
    color: #333333;
}

/* Tab Widgets */
QTabBar::tab {
    background-color: #e1e1e1;
    color: #555555;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #000000;
    border-top: 2px solid #007acc;
}

/* TreeView */
QTreeView, QListView {
    background-color: #ffffff;
    color: #333333;
    border: none;
}

QTreeView::item:selected {
    background-color: #007acc;
    color: #ffffff;
}

/* Status Bar */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
}

QStatusBar QLabel {
    background-color: transparent;
    color: #ffffff;
    padding: 2px 8px;
}

/* Text Editors & Console */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    font-size: 12px;
    border: 1px solid #cccccc;
}

QPushButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #0062a3;
}
