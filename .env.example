APP_NAME="Scilab Studio Backend"
APP_ENV="development"
DATABASE_URL="sqlite:///./scilab_studio.db"
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
LOG_LEVEL="INFO"

# Scilab Runtime Integration
# SCILAB_EXECUTABLE="/usr/bin/scilab-cli"
SCILAB_TIMEOUT="30.0"
SCILAB_WORKING_DIRECTORY="./projects"
SCILAB_MAX_OUTPUT_SIZE="1048576"

