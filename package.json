{
  "name": "scilab-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Open Engineering Development Platform",
  "license": "GPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cargo run --manifest-path zed/Cargo.toml --package zed",
    "dev:zed": "cargo run --manifest-path zed/Cargo.toml --package zed",
    "build": "cargo build --release --manifest-path zed/Cargo.toml --package zed",
    "build:zed": "cargo build --release --manifest-path zed/Cargo.toml --package zed",
    "test": "turbo test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "path-browserify": "^1.0.1"
  }
}
